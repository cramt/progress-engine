# Delver's proprietary artefacts. The crate fetches these into its own cache
# (/tmp/delver-engine by default), so nothing below should appear here any more
# - these entries only cover copies left by the fetch.sh this replaced, and any
# a cache pointed at the repo would write.
core.js
core.wasm
core.tags.wasm
data.7z
data.db
model-*.7z
model-*.dat
*.md5
*.size
version.txt

# Card scans pulled from Scryfall by .fixtures/fetch-cards.sh
.fixtures/*.jpg
.fixtures/*.json

# The app bundle, crawled to confirm the call sequence. Not ours to vendor.
.app/

node_modules/

# nix
result
result-*
.direnv/

# editor / tooling noise
*.swp
.vscode/
npm-debug.log*

# rust
/target
