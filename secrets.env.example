# Copy to secrets.env (gitignored) and fill in. Read by `nix run .#infra`.

# Account API token for the cramt account, no TTL. Account: Workers Scripts
# (edit), Workers R2 Storage (edit); Zone cramt.dk: Zone (read), DNS (edit),
# Workers Routes (edit). `infra` derives the R2 state credentials from it.
CLOUDFLARE_API_TOKEN=
# The meldweb-curator GitHub App's client secret (github.com/apps/meldweb-curator)
GITHUB_CLIENT_SECRET=
