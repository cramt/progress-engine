/target
result
result-*

# Card scans gitaxian-probe's tests recognise, pulled from Scryfall by
# crates/gitaxian-probe/engine/.fixtures/fetch-cards.sh. Not ours to vendor.
crates/gitaxian-probe/engine/.fixtures/*.jpg
crates/gitaxian-probe/engine/.fixtures/*.json

# dx builds the Android app into a dist/ beside its crate.
crates/gitaxian-probe/app/dist/

# symlink to the nix-patched deno_core; see flake.nix
vendor/

# the Python checker run in place
__pycache__/

# Meldweb Curator's web app: dependencies, build output, and the wasm package
# scripts/build-wasm.mjs regenerates from meldweb-wasm.
node_modules/
crates/meldweb-curator/web/dist/
crates/meldweb-curator/web/src/wasm/pkg/
