/target
# Gitaxian Probe is its own workspace, with its own target dir.
crates/gitaxian-probe/target/
result
result-*

# Card scans gitaxian-probe's tests recognise, pulled from Scryfall by
# crates/gitaxian-probe/engine/.fixtures/fetch-cards.sh. Not ours to vendor.
crates/gitaxian-probe/engine/.fixtures/*.jpg
crates/gitaxian-probe/engine/.fixtures/*.json

# Delver X's engine files, which gitaxian-probe-assets downloads at build time
# and a web build copies next to its output. They are Delver's, not ours to
# commit, so they are ignored by name wherever a copy lands - not only under
# target/, where the build leaves them.
core.js
core.wasm
data.7z
data.md5
data.size
model-*.7z
model-*.dat
model-*.md5
model-*.size
version.txt

# the Python checker run in place
__pycache__/
